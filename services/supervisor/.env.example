# GitHub Webhook & API credentials
GITHUB_WEBHOOK_SECRET=replace_with_strong_random_secret_hmac256
GITHUB_TOKEN=ghp_replace_with_github_pat_with_repo_scope
GITHUB_REPO_NAME=netfox-web/blender-autonomous-3d
GITHUB_ALLOWED_BRANCH=main
GITHUB_ALLOWED_ISSUE=1

# Server Bindings
SUPERVISOR_HOST=0.0.0.0
SUPERVISOR_PORT=8791

# Durable state paths
SUPERVISOR_STATE_DB_PATH=.fox3d-data/supervisor_state.db
SUPERVISOR_AUDIT_LOG_PATH=.fox3d-data/supervisor_audit.log

# AI Provider ("rule_based", "mock", "openai", "anthropic", "gemini")
SUPERVISOR_AI_PROVIDER=rule_based
SUPERVISOR_AI_API_KEY=

# Watchdog check interval in seconds (default 3600 = 1 hour)
SUPERVISOR_WATCHDOG_INTERVAL=3600
